{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Utopia Capability Bridge v1",
  "$defs": {
    "CapabilityDescriptor": {
      "type": "object",
      "required": [
        "capabilityId",
        "cityLifecycle",
        "bridgeState",
        "operations",
        "moduleRefs",
        "moduleLifecycles"
      ],
      "properties": {
        "capabilityId": {
          "type": "string"
        },
        "cityLifecycle": {
          "type": "string"
        },
        "bridgeState": {
          "enum": [
            "AVAILABLE",
            "DEGRADED",
            "BRIDGE_PENDING",
            "UNAVAILABLE"
          ]
        },
        "operations": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/CapabilityOperation"
          }
        },
        "moduleRefs": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/ModuleRef"
          }
        },
        "moduleLifecycles": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "required": [
              "moduleRef",
              "lifecycle"
            ],
            "properties": {
              "moduleRef": {
                "$ref": "#/$defs/ModuleRef"
              },
              "lifecycle": {
                "type": "string"
              }
            }
          }
        }
      }
    },
    "CapabilityOperation": {
      "type": "object",
      "required": [
        "operationId"
      ],
      "properties": {
        "operationId": {
          "type": "string"
        }
      }
    },
    "CapabilityInvocation": {
      "$ref": "#/$defs/InvocationSummary"
    },
    "CapabilityResult": {
      "type": "object",
      "required": [
        "result",
        "resultDigest"
      ],
      "properties": {
        "resultDigest": {
          "type": [
            "string",
            "null"
          ]
        },
        "result": {}
      }
    },
    "CapabilityError": {
      "type": "object",
      "required": [
        "errorCode"
      ],
      "properties": {
        "errorCode": {
          "type": "string"
        }
      }
    },
    "ModuleRef": {
      "type": "object",
      "required": [
        "districtId",
        "buildingId",
        "moduleId"
      ],
      "additionalProperties": false,
      "properties": {
        "districtId": {
          "type": "string",
          "minLength": 1
        },
        "buildingId": {
          "type": "string",
          "minLength": 1
        },
        "moduleId": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "InvocationSummary": {
      "type": "object",
      "required": [
        "invocationId",
        "capabilityId",
        "operationId",
        "status",
        "resultDigest",
        "resultAvailable"
      ],
      "additionalProperties": false,
      "properties": {
        "invocationId": {
          "type": "string"
        },
        "capabilityId": {
          "type": "string"
        },
        "operationId": {
          "type": "string"
        },
        "inputClass": {
          "type": "string"
        },
        "startedAt": {
          "type": "string"
        },
        "inputBytes": {
          "type": "integer",
          "minimum": 0
        },
        "finishedAt": {
          "type": [
            "string",
            "null"
          ]
        },
        "status": {
          "enum": [
            "RUNNING",
            "COMPLETED",
            "FAILED",
            "INTERRUPTED"
          ]
        },
        "resultDigest": {
          "type": [
            "string",
            "null"
          ]
        },
        "errorCode": {
          "type": [
            "string",
            "null"
          ]
        },
        "resultAvailable": {
          "type": "boolean"
        }
      }
    },
    "InvocationDetail": {
      "type": "object",
      "required": [
        "invocationId",
        "result"
      ],
      "properties": {
        "invocationId": {
          "type": "string"
        },
        "result": {}
      }
    }
  }
}
