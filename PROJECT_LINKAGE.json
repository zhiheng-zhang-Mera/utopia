    "implementation_to_control": "Digital-City scheduled pull every 5 minutes",
    "control_to_implementation": "reciprocal PROJECT_LINKAGE.json contract check",
    "generated_status_json": "mission-book/UTOPIA_LIVE_STATUS.json",
    "generated_status_markdown": "mission-book/UTOPIA_LIVE_STATUS.md",
