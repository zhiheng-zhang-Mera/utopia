{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:utopia:city-roads:document-knowledge:v1",
  "title": "Document to temporary knowledge Road v1",
  "$ref": "#/$defs/DocumentSections",
  "$defs": {
    "DocumentSection": {
      "type": "object",
      "required": ["kind", "text", "start", "end"],
      "properties": {
        "kind": {"type": "string", "pattern": "\\S"},
        "heading": {"type": "string"},
        "text": {"type": "string"},
        "start": {"type": "integer", "minimum": 0, "maximum": 9007199254740991},
        "end": {"type": "integer", "minimum": 0, "maximum": 9007199254740991}
      },
      "$comment": "The SDK additionally validates end >= start. Parser-specific metadata is allowed."
    },
    "DocumentSections": {"type": "array", "maxItems": 200, "items": {"$ref": "#/$defs/DocumentSection"}},
    "TemporaryKnowledgeEntry": {
      "type": "object",
      "required": ["id", "title", "content", "domain", "shelf", "tags", "trust", "updatedAt"],
      "properties": {
        "id": {"type": "string", "pattern": "^document-[0-9]+$"},
        "title": {"type": "string"},
        "content": {"type": "string"},
        "domain": {"const": "document"},
        "shelf": {"const": "temporary"},
        "tags": {"const": ["document"]},
        "trust": {"const": "UNVERIFIED"},
        "updatedAt": {"const": "1970-01-01T00:00:00.000Z"}
      },
      "$comment": "The SDK additionally validates each document-N id against its array index."
    },
    "TemporaryKnowledgeEntries": {"type": "array", "maxItems": 200, "items": {"$ref": "#/$defs/TemporaryKnowledgeEntry"}}
  }
}
