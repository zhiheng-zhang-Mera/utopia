{
 "$schema": "https://json-schema.org/draft/2020-12/schema",
 "$id": "https://utopia.digital-city/contracts/engineering-manager-v1/schema.json",
 "title": "Engineering Manager canonical contracts v1",
 "description": "Provider-neutral Engineering execution envelopes. Canonical task truth stays in Shared Task/Action Core; Remote Fabric owns trust/transport; Butler owns assistant semantics; General AI Gateway owns general-AI semantics.",
 "$defs": {
  "owner": {
   "type": "object", "additionalProperties": false, "required": ["task_owner_ref", "coordinator_ref"],
   "properties": { "task_owner_ref": { "type": "string", "minLength": 1 }, "coordinator_ref": { "type": "string", "minLength": 1 } }
  },
  "executor": {
   "type": "object", "additionalProperties": false, "required": ["host_kind", "host_ref", "placement"],
   "properties": {
    "host_kind": { "enum": ["LOCAL", "REMOTE"] },
    "host_ref": { "type": "string", "minLength": 1 },
    "placement": { "enum": ["LOCAL_ALLOWED", "LOCAL_THROTTLED", "LOCAL_BLOCKED", "LOCAL_UNAVAILABLE", "REMOTE_APPROVED"] }
   }
  },
  "workspace": {
   "type": "object", "additionalProperties": false, "required": ["repo_ref", "worktree_ref", "branch_ref"],
   "properties": {
    "repo_ref": { "type": "string", "minLength": 1 },
    "worktree_ref": { "type": ["string", "null"] },
    "branch_ref": { "type": ["string", "null"] }
   }
  },
  "scope": {
   "type": "object", "additionalProperties": false, "required": ["include_refs", "exclude_refs"],
   "properties": { "include_refs": { "type": "array", "items": { "type": "string" } }, "exclude_refs": { "type": "array", "items": { "type": "string" } } }
  },
  "acceptance": {
   "type": "object", "additionalProperties": false, "required": ["criteria_refs", "required_checks"],
   "properties": { "criteria_refs": { "type": "array", "items": { "type": "string" } }, "required_checks": { "type": "array", "items": { "type": "string" } } }
  },
  "job": {
   "type": "object",
   "additionalProperties": false,
   "required": ["contract_version", "route", "job_ref", "city_task_ref", "execution_mode", "owner", "executor", "connector_instance_ref", "workspace", "scope", "acceptance", "permission_context_ref", "risk_class", "context_refs", "checkpoints", "evidence_refs", "artifact_refs", "lease_ref", "idempotency_key", "job_version", "state", "blocking_state", "created_at", "updated_at"],
   "properties": {
    "contract_version": { "const": 1 },
    "route": { "const": "ENGINEERING" },
    "job_ref": { "type": "string", "minLength": 1 },
    "city_task_ref": { "type": "string", "minLength": 1 },
    "execution_mode": { "enum": ["AUTONOMOUS_AGENT", "SCRIPTED_EXECUTOR", "INTERACTIVE_AGENT"] },
    "owner": { "$ref": "#/$defs/owner" },
    "executor": { "$ref": "#/$defs/executor" },
    "connector_instance_ref": { "type": "string", "minLength": 1 },
    "workspace": { "$ref": "#/$defs/workspace" },
    "scope": { "$ref": "#/$defs/scope" },
    "acceptance": { "$ref": "#/$defs/acceptance" },
    "permission_context_ref": { "type": "string", "minLength": 1 },
    "risk_class": { "enum": ["LOW", "MEDIUM", "HIGH"] },
    "context_refs": { "type": "array", "items": { "type": "string" } },
    "checkpoints": { "type": "array", "items": { "type": "string" } },
    "evidence_refs": { "type": "array", "items": { "type": "string" } },
    "artifact_refs": { "type": "array", "items": { "type": "string" } },
    "lease_ref": { "type": ["string", "null"] },
    "idempotency_key": { "type": "string", "minLength": 1 },
    "job_version": { "type": "integer", "minimum": 1 },
    "state": { "enum": ["SUBMITTED", "QUEUED", "RUNNING", "PAUSED", "WAITING_ATTENTION", "BLOCKED", "SUCCEEDED", "FAILED", "CANCELLED", "REFUSED", "RECOVERING"] },
    "blocking_state": { "enum": [null, "LOCAL_BLOCKED", "LOCAL_UNAVAILABLE", "AUTH_REQUIRED", "USER_APPROVAL_REQUIRED", "PHYSICAL_ACTION_REQUIRED"] },
    "operations": { "type": "array", "items": { "type": "string" }, "description": "Required for SCRIPTED_EXECUTOR; forbidden for autonomous/interactive modes." },
    "created_at": { "type": "string" },
    "updated_at": { "type": "string" }
   }
  },
  "event": {
   "type": "object", "additionalProperties": false,
   "required": ["contract_version", "event_id", "job_ref", "event_type", "job_version", "sequence", "at", "payload"],
   "properties": {
    "contract_version": { "const": 1 },
    "event_id": { "type": "string", "minLength": 1 },
    "job_ref": { "type": "string", "minLength": 1 },
    "event_type": { "enum": ["JOB_SUBMITTED", "JOB_STATE_CHANGED", "PROGRESS", "LOG", "ATTENTION_REQUIRED", "ATTENTION_ACKNOWLEDGED", "ARTIFACT_PRODUCED", "RESULT_READY", "CONTROL_ACCEPTED", "CONTROL_REJECTED", "HEALTH_CHANGED", "RECOVERY_REQUESTED"] },
    "job_version": { "type": "integer", "minimum": 1 },
    "sequence": { "type": "integer", "minimum": 0 },
    "at": { "type": "string" },
    "payload": { "type": "object" }
   }
  },
  "attention": {
   "type": "object", "additionalProperties": false,
   "required": ["contract_version", "attention_id", "job_ref", "blocking", "question", "projections", "acknowledgement", "created_at"],
   "properties": {
    "contract_version": { "const": 1 },
    "attention_id": { "type": "string", "minLength": 1 },
    "job_ref": { "type": "string", "minLength": 1 },
    "blocking": { "type": "boolean" },
    "question": { "type": "string", "minLength": 1 },
    "projections": {
     "type": "array", "maxItems": 4,
     "items": {
      "type": "object", "additionalProperties": false, "required": ["device_ref", "projection", "delivered_at", "ringing", "actionable"],
      "properties": {
       "device_ref": { "type": "string", "minLength": 1 },
       "projection": { "enum": ["ACTIONABLE", "NOTIFY", "RING"] },
       "delivered_at": { "type": ["string", "null"] },
       "ringing": { "type": "boolean" },
       "actionable": { "type": "boolean" }
      }
     }
    },
    "acknowledgement": {
     "type": "object", "additionalProperties": false, "required": ["status", "acknowledged_by", "at"],
     "properties": {
      "status": { "enum": ["PENDING", "ACKNOWLEDGED", "EXPIRED"] },
      "acknowledged_by": { "type": ["string", "null"] },
      "at": { "type": ["string", "null"] }
     }
    },
    "created_at": { "type": "string" }
   }
  },
  "artifact": {
   "type": "object", "additionalProperties": false,
   "required": ["contract_version", "artifact_ref", "job_ref", "kind", "media_type", "digest", "size_bytes", "storage_ref", "produced_at"],
   "properties": {
    "contract_version": { "const": 1 },
    "artifact_ref": { "type": "string", "minLength": 1 },
    "job_ref": { "type": "string", "minLength": 1 },
    "kind": { "type": "string", "minLength": 1 },
    "media_type": { "type": "string", "minLength": 1 },
    "digest": { "type": "string", "pattern": "^sha256:[0-9a-f]{64}$" },
    "size_bytes": { "type": "integer", "minimum": 0 },
    "storage_ref": { "type": "string", "minLength": 1 },
    "produced_at": { "type": "string" }
   }
  },
  "result": {
   "type": "object", "additionalProperties": false,
   "required": ["contract_version", "result_ref", "job_ref", "job_version", "outcome", "acceptance", "changed_files", "tests", "branch_ref", "commit_ref", "artifact_refs", "blocking_state", "produced_at"],
   "properties": {
    "contract_version": { "const": 1 },
    "result_ref": { "type": "string", "minLength": 1 },
    "job_ref": { "type": "string", "minLength": 1 },
    "job_version": { "type": "integer", "minimum": 1 },
    "outcome": { "enum": ["SUCCEEDED", "FAILED", "CANCELLED", "REFUSED"] },
    "acceptance": {
     "type": "object", "additionalProperties": false, "required": ["status", "evidence_refs"],
     "properties": { "status": { "enum": ["PASS", "FAIL", "NOT_REQUIRED"] }, "evidence_refs": { "type": "array", "items": { "type": "string" } } }
    },
    "changed_files": {
     "type": "array",
     "items": {
      "type": "object", "additionalProperties": false, "required": ["path", "status", "digest"],
      "properties": { "path": { "type": "string", "minLength": 1 }, "status": { "enum": ["ADDED", "MODIFIED", "DELETED", "RENAMED"] }, "digest": { "type": ["string", "null"] } }
     }
    },
    "tests": {
     "type": "array",
     "items": {
      "type": "object", "additionalProperties": false, "required": ["name", "status"],
      "properties": { "name": { "type": "string", "minLength": 1 }, "status": { "enum": ["PASS", "FAIL", "SKIPPED"] } }
     }
    },
    "branch_ref": { "type": ["string", "null"] },
    "commit_ref": { "type": ["string", "null"] },
    "artifact_refs": { "type": "array", "items": { "type": "string" } },
    "blocking_state": { "enum": [null, "LOCAL_BLOCKED", "LOCAL_UNAVAILABLE", "AUTH_REQUIRED", "USER_APPROVAL_REQUIRED", "PHYSICAL_ACTION_REQUIRED"] },
    "produced_at": { "type": "string" }
   }
  },
  "connectorDescriptor": {
   "type": "object", "additionalProperties": false,
   "required": ["contract_version", "connector_kind", "descriptor_version", "display_name", "provider_ref", "transports", "capabilities", "auth_required"],
   "properties": {
    "contract_version": { "const": 1 },
    "connector_kind": { "type": "string", "minLength": 1 },
    "descriptor_version": { "type": "integer", "minimum": 1 },
    "display_name": { "type": "string", "minLength": 1 },
    "provider_ref": { "type": ["string", "null"], "description": "Opaque provider reference. The core contract never requires a provider product name." },
    "transports": { "type": "array", "items": { "type": "string" } },
    "capabilities": {
     "type": "array",
     "items": {
      "type": "object", "additionalProperties": false, "required": ["capability_id", "capability_version"],
      "properties": { "capability_id": { "type": "string", "minLength": 1 }, "capability_version": { "type": "integer", "minimum": 1 } }
     }
    },
    "auth_required": { "type": "boolean" }
   }
  },
  "remoteFallback": {
   "type": "object", "additionalProperties": false,
   "required": ["contract_version", "proposal_ref", "job_ref", "owner_ref", "reason", "candidates", "requires_user_approval", "scope", "status", "created_at"],
   "properties": {
    "contract_version": { "const": 1 },
    "proposal_ref": { "type": "string", "minLength": 1 },
    "job_ref": { "type": "string", "minLength": 1 },
    "owner_ref": { "type": "string", "minLength": 1 },
    "reason": { "enum": ["LOCAL_BLOCKED", "LOCAL_UNAVAILABLE"] },
    "candidates": {
     "type": "array", "minItems": 1, "maxItems": 3,
     "items": {
      "type": "object", "additionalProperties": false, "required": ["host_ref", "measured_reason", "capability_refs"],
      "properties": {
       "host_ref": { "type": "string", "minLength": 1 },
       "measured_reason": { "enum": ["LOCAL_BLOCKED", "LOCAL_UNAVAILABLE"] },
       "capability_refs": { "type": "array", "items": { "type": "string" } }
      }
     }
    },
    "requires_user_approval": { "const": true, "description": "V1 hard rule: no remote Sub-worker starts before explicit user approval." },
    "scope": { "const": "CURRENT_JOB" },
    "status": { "enum": ["PROPOSED", "APPROVED", "REJECTED", "EXPIRED"] },
    "created_at": { "type": "string" }
   }
  }
 },
 "x-ownership-boundary": {
  "route": "ENGINEERING",
  "engineering_manager_owns_task_truth": false,
  "canonical_task_truth_owner": "Shared Task/Action Core",
  "forbidden_foreign_routes": ["ROOM", "ROOMS", "CAPABILITY", "CAPABILITIES", "CITY_TASK", "CITY_TASKS", "GENERAL_AI", "GENERAL_AI_GATEWAY", "ASSISTANT", "BUTLER", "REMOTE_FABRIC"],
  "forbidden_raw_secret_fields": "any token/secret/password/cookie/api-key/private-key/credential field without a _ref or _handle suffix",
  "forbidden_donor": "Codex-Boss"
 }
}
